---
const { title, subtitle } = Astro.props;
---

<header class="mb-xl border-b border-border pb-md">
  <h1 class="text-3xl font-heading font-bold text-text-primary tracking-tight">
    {title}
  </h1>
  {subtitle && (
    <p class="mt-sm text-lg text-text-secondary font-body">{subtitle}</p>
  )}
</header>
