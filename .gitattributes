# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly mark common text file types
*.ts     text
*.tsx    text
*.js     text
*.jsx    text
*.json   text
*.md     text
*.yml    text
*.yaml   text
*.html   text
*.css    text
*.scss   text
*.sh     text eol=lf

# Treat lockfiles as text but keep exact formatting
pnpm-lock.yaml text eol=lf
package-lock.json text eol=lf
yarn.lock text eol=lf

# Binary files (no diffing)
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.zip    binary
*.gz     binary

# Keep generated build outputs as binary
dist/*   binary
