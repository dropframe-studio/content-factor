{
  "name": "content-factor",
  "version": "1.0.0",
  "description": "The measurable, automated pipeline for content visibility.",
  "main": "pipeline/index.ts",
  "type": "module",
  "bin": {
    "cf": "./dist/bin/cf.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/bin/cf.js",
    "start": "pnpm build && pnpm pipeline",
    "capture:commit": "node dist/pipeline/capture/commit.js",
    "capture:retro": "node dist/pipeline/capture/retro.js",
    "capture:note": "node dist/pipeline/capture/note.js",
    "capture:link": "node dist/pipeline/capture/link.js",
    "capture:screenshot": "node dist/pipeline/capture/screenshot.js",
    "transform": "node dist/pipeline/transform.js",
    "publish-content": "node dist/pipeline/publish.js",
    "measure": "node dist/pipeline/measure.js",
    "pipeline": "echo 'Running pipeline...' && pnpm capture:commit && pnpm transform && pnpm publish-content && pnpm measure && echo 'Pipeline complete.'",
    "audit:todos": "node scripts/audit-todos.js"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fs-extra": "^11.3.2",
    "lowdb": "^7.0.1",
    "sqlite3": "^5.1.7",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.9.1",
    "@types/sqlite3": "^3.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3"
    ]
  }
}
