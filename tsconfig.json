{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["bin/**/*.ts", "pipeline/**/*.ts", "scripts/**/*.ts", "publish/**/*.ts", "sync/**/*.ts", "templates/**/*.ts"],
  "exclude": ["web_app", "docs", "design"]
}
